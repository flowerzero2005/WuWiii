{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "paths": {
      "@proj-airi/server-shared/vision-limits": [
        "../../packages/server-shared/src/vision-limits.ts"
      ],
      "@proj-airi/electron-screen-capture": [
        "../../packages/electron-screen-capture/src/index.ts"
      ],
      "@proj-airi/electron-screen-capture/*": [
        "../../packages/electron-screen-capture/src/*"
      ]
    },
    "target": "ESNext",
    "jsx": "preserve",
    "lib": [
      "ESNext"
    ],
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "types": [
      "vitest",
      "vite/client",
      "electron-vite/node",
      "unplugin-info/client"
    ],
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "../../packages/server-shared/src/vision-limits.ts",
    "../../packages/electron-screen-capture/src/index.ts",
    "../../packages/electron-screen-capture/src/main/index.ts",
    "../../packages/electron-screen-capture/src/main/utils.ts",
    "../../packages/electron-screen-capture/src/main/source-thumbnail.ts",
    "../../uno.config.ts",
    "uno.config.ts",
    "electron.vite.config.ts",

    "src/main/**/*.ts",
    "src/main/**/*.d.ts",
    "src/main/**/*.tsx",
    "src/main/**/*.vue",

    "src/shared/**/*.ts",
    "src/shared/**/*.d.ts",
    "src/shared/**/*.tsx",
    "src/shared/**/*.vue"
  ]
}
