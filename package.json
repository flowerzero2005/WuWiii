{
  "name": "@proj-airi/root",
  "type": "module",
  "version": "0.9.0-beta.5",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "description": "LLM powered virtual character",
  "author": {
    "name": "Moeru AI Project AIRI Team",
    "email": "airi@moeru.ai",
    "url": "https://github.com/moeru-ai"
  },
  "license": "MIT",
  "scripts": {
    "postinstall": "pnpm run build:packages",
    "dev": "pnpm -F @proj-airi/stage-tamagotchi dev",
    "dev:ui": "pnpm -rF @proj-airi/stage-ui run story:dev",
    "dev:tamagotchi": "pnpm -rF @proj-airi/stage-tamagotchi run dev",
    "build": "node scripts/build-source.mjs",
    "build:tamagotchi": "node scripts/build-source.mjs",
    "build:packages": "turbo run build -F=\"./packages/*\"",
    "test": "vitest --coverage",
    "test:run": "vitest run",
    "test:run:safe": "node scripts/run-vitest-safe.mjs run --pool threads --maxWorkers 1 --exclude \"**/llm.test.ts\"",
    "lint": "node scripts/run-lint.mjs",
    "lint:fix": "node scripts/run-lint.mjs --fix",
    "typecheck": "pnpm -rF=\"./packages/*\" -F @proj-airi/stage-tamagotchi --workspace-concurrency=2 typecheck",
    "typecheck:safe": "pnpm -rF=\"./packages/*\" -F @proj-airi/stage-tamagotchi --workspace-concurrency=1 typecheck",
    "knip": "knip",
    "check:dev": "node scripts/check-dev-setup.mjs",
    "build:source": "node scripts/build-source.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.6.1",
    "@arethetypeswrong/core": "^0.18.2",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@iconify/utils": "^3.1.0",
    "@moeru/eslint-config": "catalog:",
    "@proj-airi/unocss-preset-chromatic": "^1.0.2",
    "@types/node": "^24.10.14",
    "@unocss/eslint-config": "^66.6.2",
    "@unocss/eslint-plugin": "^66.6.2",
    "@unocss/preset-mini": "^66.6.2",
    "@unocss/preset-web-fonts": "^66.6.2",
    "@vitest/coverage-v8": "catalog:vitest",
    "eslint": "^9.39.3",
    "eslint-plugin-oxlint": "^1.50.0",
    "knip": "catalog:",
    "oxlint": "^1.50.0",
    "posthog-js": "catalog:",
    "publint": "^0.3.17",
    "rollup": "^4.59.0",
    "smol-toml": "^1.6.0",
    "tinyexec": "^1.0.2",
    "tsdown": "catalog:",
    "tsx": "^4.21.0",
    "turbo": "^2.8.11",
    "typescript": "~5.9.3",
    "uncrypto": "^0.1.3",
    "unocss": "^66.6.2",
    "unocss-preset-scrollbar": "^3.2.0",
    "unplugin-lightningcss": "^0.4.5",
    "unplugin-raw": "^0.6.4",
    "unplugin-unused": "^0.5.7",
    "unplugin-vue": "^7.1.1",
    "vite": "^7.3.1",
    "vite-plugin-inspect": "^11.3.3",
    "vitest": "^4.0.18",
    "yaml": "^2.8.2"
  },
  "workspaces": [
    "packages/**",
    "apps/**"
  ]
}
